// Build settings shared by every target.
//
// Signing identity lives in Config/Signing.xcconfig, which is not checked in.
// Copy Config/Signing.example.xcconfig to Config/Signing.xcconfig and fill in
// your own team to build for a device or to archive.

MARKETING_VERSION = 1.1.1
CURRENT_PROJECT_VERSION = 3

OPENSCREENS_BUNDLE_ID = com.burakgon.openscreens
OPENSCREENS_APP_GROUP = group.$(OPENSCREENS_BUNDLE_ID)

SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
MACOSX_DEPLOYMENT_TARGET = 26.0
IPHONEOS_DEPLOYMENT_TARGET = 26.0

CODE_SIGN_STYLE = Automatic
ENABLE_USER_SCRIPT_SANDBOXING = YES
DEAD_CODE_STRIPPING = YES
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor
GENERATE_INFOPLIST_FILE = NO

#include? "Signing.xcconfig"
